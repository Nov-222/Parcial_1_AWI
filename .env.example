# Copy to .env and adjust. docker compose reads .env automatically.
DB_NAME=nombre_de_tu_base
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_HOST=host
DB_PORT=puerto

# Flask session signing (Jinja pages keep the JWT in this cookie).
SECRET_KEY=change-me-in-production

# Signs the login tokens. Different from SECRET_KEY, at least 32 bytes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string
JWT_EXPIRES_MINUTES=60
JWT_ISSUER=lacarta

# Gunicorn
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=3
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=30
